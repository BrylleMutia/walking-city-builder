        <!-- The diagonal paving seams slide left one period (2100 local units = 1378 on the card) per
             loop, at about the speed a planted foot slides back (~1.4 units per frame). -->
        <LinearAnimation loopValue="loop" duration="960" name="Ground" id="0:71">
