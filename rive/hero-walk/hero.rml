        <!-- One walk cycle, two steps, 1 s. Frame 0 (and 60) is the drawn pose: front (far) leg raised,
             back (near) leg planted. Contacts at 12 (front) and 42 (back), where the body dips; the planted
             foot slides back at about the ground's speed (see Ground). Every key eases in-out. -->
        <LinearAnimation loopValue="loop" duration="60" name="Walk" id="0:70">
            <!-- Body: dip on each contact, a hair of forward lean with it. -->
            <KeyedObject objectId="0:40">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="660" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="672" frame="12" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="658" frame="30" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="672" frame="42" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="660" frame="60" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-1.5707964" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-1.5588" frame="12" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-1.5707964" frame="30" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-1.5588" frame="42" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-1.5707964" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Head (with the log and gripping hand): nods a little after each dip. -->
            <KeyedObject objectId="0:41">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.025" frame="16" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="30" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.025" frame="46" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Free arm: rides the body's dip and swings forward while the near (back) leg lifts. -->
            <KeyedObject objectId="0:42">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="388" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="400" frame="12" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
