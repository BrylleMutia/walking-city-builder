{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-phone",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--dev-client", "--tunnel", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "expo-emulator",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--go", "--port", "8082"],
      "port": 8082
    },
    {
      "name": "artifacts",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "e2e-artifacts"],
      "port": 8765
    }
  ]
}
