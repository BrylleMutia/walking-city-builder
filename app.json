{
  "expo": {
    "name": "Stridewood",
    "description": "Build your town, one step at a time.",
    "slug": "stridewood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stridewood.app"
    },
    "android": {
      "package": "com.stridewood.app",
      "permissions": [
        "android.permission.health.READ_STEPS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#BCE9D8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C9F2E3"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect"
    ],
    "scheme": "stridewood",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1cb226fc-fdb0-4b2f-ba7c-06f8cc5fb467"
      }
    },
    "owner": "bryllemutia"
  }
}
